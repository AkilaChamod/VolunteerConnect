<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Event | VolunteerConnect</title><link rel="stylesheet" href="/css/style.css"></head>
<body><header class="topbar"><a class="top-brand" href="/dashboard">VolunteerConnect</a><div class="top-actions"><span><%= user.name %></span><form method="POST" action="/logout"><button class="button secondary" type="submit">Log out</button></form></div></header>
<main class="container narrow"><% if (flash) { %><div class="alert <%= flash.type %>"><%= flash.message %></div><% } %><% if (errors.length) { %><div class="alert error"><% errors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %>
<% if (event) { %><a class="back-link" href="/dashboard">← Back to dashboard</a><article class="event-detail"><span class="pill">Volunteer opportunity</span><h1><%= event.title %></h1><p class="muted">Hosted by <%= event.charity_name %></p>
<div class="detail-grid"><div><strong>Date & time</strong><span><%= new Date(event.event_date).toLocaleString() %></span></div><div><strong>Location</strong><span><%= event.location %></span></div><div><strong>Capacity</strong><span><%= event.registered_count %> / <%= event.capacity %> registered</span></div></div>
<h2>About this opportunity</h2><p class="description"><%= event.description %></p>
<% if (user.role === 'student') { %><% if (registered) { %><div class="status success">You are registered for this event.</div><% } else if (event.registered_count >= event.capacity) { %><div class="status warning">This event is currently full.</div><% } else { %><form method="POST" action="/events/<%= event.id %>/register"><button type="submit">Register for this event</button></form><% } %><% } %>
<% if (user.role === 'charity' && user.id === event.charity_id) { %><section class="registrants"><h2>Registered students</h2><% if (!registrants.length) { %><p class="muted">No students have registered yet.</p><% } else { %><ul><% registrants.forEach(student => { %><li><strong><%= student.name %></strong><span><%= student.email %></span></li><% }) %></ul><% } %></section><% } %></article><% } %></main></body></html>
